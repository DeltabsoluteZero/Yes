<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary Colors (Dark variant) -->
        <item name="colorPrimary">@color/dark_primary</item>
        <item name="colorPrimaryVariant">@color/dark_primary_dark</item>
        <item name="colorOnPrimary">@color/dark_on_surface</item>

        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/dark_secondary</item>
        <item name="colorSecondaryVariant">@color/dark_secondary</item>
        <item name="colorOnSecondary">@color/dark_on_surface</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/dark_surface</item>
        <item name="android:navigationBarColor">@color/dark_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:colorBackground">@color/dark_background</item>

        <!-- Surface -->
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_on_surface</item>

        <!-- Error -->
        <item name="colorError">@color/error_light</item>
        <item name="colorOnError">@color/dark_on_surface</item>

        <!-- Typography -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.App.HeadlineLarge.Dark</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.App.HeadlineMedium.Dark</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.App.HeadlineSmall.Dark</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.TitleLarge.Dark</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.TitleMedium.Dark</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.App.TitleSmall.Dark</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.BodyLarge.Dark</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.App.BodyMedium.Dark</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.App.BodySmall.Dark</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.App.LabelLarge.Dark</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.App.LabelMedium.Dark</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.App.LabelSmall.Dark</item>

        <!-- Shape -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.App.LargeComponent</item>

        <!-- Ripple -->
        <item name="colorControlHighlight">@color/dark_primary_light</item>

        <!-- Divider -->
        <item name="android:listDivider">@color/dark_divider</item>
    </style>

    <!-- Dark Text Appearances (using AppCompat parents) -->
    <style name="TextAppearance.App.HeadlineLarge.Dark" parent="TextAppearance.AppCompat.Headline">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/dark_on_surface</item>
    </style>

    <style name="TextAppearance.App.HeadlineMedium.Dark" parent="TextAppearance.AppCompat.Headline">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/dark_on_surface</item>
    </style>

    <style name="TextAppearance.App.HeadlineSmall.Dark" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/dark_on_surface</item>
    </style>

    <style name="TextAppearance.App.TitleLarge.Dark" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/dark_on_surface</item>
    </style>

    <style name="TextAppearance.App.TitleMedium.Dark" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textColor">@color/dark_on_surface</item>
    </style>

    <style name="TextAppearance.App.TitleSmall.Dark" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/dark_on_surface</item>
    </style>

    <style name="TextAppearance.App.BodyLarge.Dark" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.5</item>
        <item name="android:textColor">@color/dark_on_surface</item>
    </style>

    <style name="TextAppearance.App.BodyMedium.Dark" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.25</item>
        <item name="android:textColor">#B6B6B6</item>
    </style>

    <style name="TextAppearance.App.BodySmall.Dark" parent="TextAppearance.AppCompat.Body2">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.4</item>
        <item name="android:textColor">#B6B6B6</item>
    </style>

    <style name="TextAppearance.App.LabelLarge.Dark" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/dark_on_surface</item>
    </style>

    <style name="TextAppearance.App.LabelMedium.Dark" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.5</item>
        <item name="android:textColor">#B6B6B6</item>
    </style>

    <style name="TextAppearance.App.LabelSmall.Dark" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.5</item>
        <item name="android:textColor">#888888</item>
    </style>

    <!-- Dark Card Background -->
    <style name="Widget.App.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/dark_card_background</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardMaxElevation">8dp</item>
    </style>

    <style name="Widget.App.Card.Outlined" parent="Widget.App.Card">
        <item name="strokeColor">@color/dark_divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Dark Progress Indicators -->
    <style name="Widget.App.ProgressIndicator.Circular" parent="Widget.MaterialComponents.CircularProgressIndicator">
        <item name="indicatorColor">@color/dark_primary</item>
        <item name="trackColor">@color/dark_surface_variant</item>
    </style>

    <style name="Widget.App.ProgressIndicator.Linear" parent="Widget.MaterialComponents.LinearProgressIndicator">
        <item name="indicatorColor">@color/dark_primary</item>
        <item name="trackColor">@color/dark_surface_variant</item>
    </style>

    <!-- Dark Switch -->
    <style name="Widget.App.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="thumbTint">@color/dark_primary</item>
        <item name="trackTint">@color/dark_surface_variant</item>
    </style>

    <!-- Dark TextInputLayout -->
    <style name="Widget.App.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/dark_divider</item>
        <item name="boxBackgroundColor">@color/dark_surface</item>
        <item name="hintTextColor">#888888</item>
    </style>

    <!-- Dark Toolbar -->
    <style name="Widget.App.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="titleTextAppearance">@style/TextAppearance.App.TitleLarge.Dark</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.App.BodyMedium.Dark</item>
        <item name="navigationIconTint">@color/dark_on_surface</item>
        <item name="android:background">@color/dark_surface</item>
    </style>

</resources>
