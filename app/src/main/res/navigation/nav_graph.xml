<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_dashboard">

    <fragment
        android:id="@+id/nav_dashboard"
        android:name="com.pixelsu.ui.main.DashboardFragment"
        android:label="@string/title_root_status"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/nav_temp_root"
        android:name="com.pixelsu.ui.main.TempRootFragment"
        android:label="@string/title_temp_root"
        tools:layout="@layout/fragment_temp_root" />

    <fragment
        android:id="@+id/nav_root_hide"
        android:name="com.pixelsu.ui.hide.RootHideFragment"
        android:label="@string/title_root_hide"
        tools:layout="@layout/fragment_root_hide" />

    <fragment
        android:id="@+id/nav_exploits"
        android:name="com.pixelsu.ui.exploit.ExploitManagerFragment"
