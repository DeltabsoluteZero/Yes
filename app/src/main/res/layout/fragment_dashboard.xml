<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:fillViewport="true"
    tools:context=".ui.main.DashboardFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Root Status Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_root_status"
            style="@style/Widget.App.Card.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/iv_root_status"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_root_inactive"
                    android:contentDescription="@string/title_root_status" />

                <TextView
                    android:id="@+id/tv_root_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/status_not_rooted"
                    android:textAppearance="@style/TextAppearance.App.HeadlineSmall"
                    android:textAlignment="center" />

                <TextView
                    android:id="@+id/tv_temp_root_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.App.BodyMedium"
                    android:textColor="@color/warning"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Root Info Card -->
        <androidx.cardview.widget.CardView
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/title_root_status"
                    android:textAppearance="@style/TextAppearance.App.TitleMedium"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tv_root_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Type: Unknown"
                        android:textAppearance="@style/TextAppearance.App.BodyMedium" />

                    <TextView
                        android:id="@+id/tv_magisk_version"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Magisk: Not detected"
                        android:textAppearance="@style/TextAppearance.App.BodySmall"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tv_kernel_version"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Kernel: Unknown"
                        android:textAppearance="@style/TextAppearance.App.BodySmall"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tv_selinux_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="SELinux: Unknown"
                        android:textAppearance="@style/TextAppearance.App.BodySmall"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tv_device_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Device Info"
                        android:textAppearance="@style/TextAppearance.App.BodySmall"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_enable_root"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/btn_enable_root" />

            <Button
                android:id="@+id/btn_temp_root"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/btn_enable_temp" />

            <Button
                android:id="@+id/btn_root_hide"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/btn_enable_hide" />

            <Button
                android:id="@+id/btn_exploits"
                style="@style/Widget.App.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/btn_manage_exploits" />

            <Button
                android:id="@+id/btn_logs"
                style="@style/Widget.App.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/btn_view_logs" />

            <Button
                android:id="@+id/btn_refresh"
                style="@style/Widget.App.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_refresh" />

        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progress_bar"
            style="@style/Widget.App.ProgressIndicator.Circular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

